rules_version = '2';
service firebase.storage { match /b/{b}/o {
  match /captainDocs/{u}/{f} {
    allow write: if request.auth != null && request.auth.uid == u && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*|application/pdf');
    allow read: if request.auth != null && (request.auth.uid == u || firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid)));
  }
}}
