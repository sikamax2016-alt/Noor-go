rules_version = '2';
service cloud.firestore { match /databases/{d}/documents {
  function signed(){ return request.auth != null; }
  function uid(){ return request.auth.uid; }
  function isStaff(){ return signed() && exists(/databases/$(d)/documents/staff/$(uid())); }
  function role(){ return get(/databases/$(d)/documents/staff/$(uid())).data.role; }
  function isMgr(){ return isStaff() && role() == 'manager'; }
  function isCap(){ return signed() && get(/databases/$(d)/documents/captains/$(uid())).data.status == 'approved'; }
  match /staff/{u} { allow read: if signed() && (uid() == u || isMgr()); allow create, update: if isMgr() && request.resource.data.role != 'manager'; allow delete: if isMgr() && resource.data.role != 'manager';
    allow update: if uid() == u && resource.data.get('codeHash', null) == null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['codeHash','codeSalt']); }
  match /users/{u} {
    allow read: if signed() && (uid() == u || isStaff());
    allow create: if uid() == u && request.resource.data.keys().hasOnly(['phone','name','createdAt']);
    allow delete: if uid() == u;
    allow update: if uid() == u && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','fcmToken']);
  }
  match /wallets/{u} { allow read: if signed() && (uid() == u || isStaff()); allow write: if isMgr(); }
  match /walletRequests/{r} {
    allow create: if signed() && request.resource.data.uid == uid() && request.resource.data.status == 'pending' && request.resource.data.amount >= 10 && request.resource.data.amount <= 5000;
    allow read: if signed() && (resource.data.uid == uid() || isMgr() || (isStaff() && role() == 'accountant'));
    allow update, delete: if isMgr();
  }
  match /promos/{c} { allow get: if signed(); allow list: if isMgr(); allow write: if isMgr(); }
  match /redemptions/{id} { allow create: if signed() && id.matches(uid() + '_.*') && request.resource.data.uid == uid(); allow get: if signed() && id.matches(uid() + '_.*'); allow list: if isMgr(); }
  match /tickets/{t} {
    allow create: if signed() && request.resource.data.uid == uid() && request.resource.data.status == 'open';
    allow read: if signed() && (resource.data.uid == uid() || isMgr() || (isStaff() && role() == 'support'));
    allow update: if isMgr() || (isStaff() && role() == 'support');
  }
  match /captains/{u} {
    allow read: if signed();
    allow create: if uid() == u && request.resource.data.status == 'pending';
    allow delete: if uid() == u;
    allow update: if (uid() == u && resource.data.status == 'approved' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['online','loc']))
                  || (isStaff() && (role() == 'reviewer' || role() == 'manager'));
  }
  match /rides/{r} {
    allow create: if signed() && request.resource.data.riderId == uid() && request.resource.data.status == 'requested';
    allow read: if signed() && (resource.data.riderId == uid() || resource.data.driverId == uid() || isStaff() || (resource.data.status == 'requested' && isCap()));
    allow update: if signed() && (
      (resource.data.riderId == uid() && request.resource.data.status == 'cancelled') ||
      (isCap() && resource.data.status == 'requested' && request.resource.data.driverId == uid() && request.resource.data.status == 'accepted') ||
      (resource.data.driverId == uid()) ||
      (isStaff() && (role() == 'support' || role() == 'dispatcher' || role() == 'manager')));
  }
  match /auditLog/{l} { allow create: if isStaff(); allow read: if isMgr(); }
}}
